{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        {
            "type": "os",
            "format": "{pretty-name} ({arch})"
        },
        {
            "type": "disk",
            "folders": "/",
            "format": "{?years}{years} years, {?}{days-of-year} days ({create-time:10})",
            "key": "OS Age"
        },
        {
            "type": "host",
            "format": "{/2}{-}{/}{2}{?3} {3}{?}"
        },
        "kernel",
        "uptime",
        {
            "type": "display",
            "key": "Display ({name})",
            "format": "{inch}\" {width}x{height} @ {refresh-rate}Hz ({ppi} PPI){?is-primary} *{?}"
        },
        "break",
        "packages",
        "shell",
        {
            "type": "terminal",
            "format": "{pretty-name} {version}"
        },
        "de",
        "wm",
        "theme",
        "break",
        "cpu",
        "gpu",
        "processes",
        {
            "type": "memory",
            "key": "RAM"
        },
        {
            "type": "disk",
            "key": "Disk ({mountpoint})",
            "format": "{size-used} \/ {size-total} ({size-percentage}) - {filesystem}"
        },
        "break",
        "colors"
    ]
}
