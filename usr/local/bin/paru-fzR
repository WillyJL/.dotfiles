#!/bin/bash
set -eu

fzf_args=(
  --ansi
  --multi
  --preview 'echo {1} | cut -d/ -f2 | xargs paru -Qi | bat -p -f -l yaml'
  --preview-label=' alt-p: toggle description, alt-f/F: toggle file list, page-up/down: scroll, tab: multi-select '
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'page-up:preview-up,page-down:preview-down'
  --bind 'alt-f:change-preview:echo {1} | cut -d/ -f2 | xargs paru -Qql'
  --bind 'alt-F:change-preview:echo {1} | cut -d/ -f2 | xargs paru -Qi | bat -p -f -l yaml'
  --color 'pointer:red,marker:red'
)

pkgs=$(cat <(paru -Qq --native | sed -E -e 's|^|\x1B[1;34msystem\x1B[0m/\x1B[1;37m|g') <(paru -Qq --foreign | sed -E -e 's|^|\x1B[1;36maur\x1B[0m/\x1B[1;37m|g') | fzf "${fzf_args[@]}")

if [[ -n "$pkgs" ]]; then
    # Convert newline-separated selections to space-separated
    pkgs=$(echo "$pkgs" | cut -d/ -f2- | tr '\n' ' ')
    echo -e "\x1B[1;34m::\x1B[1;37m Running:\x1B[0m paru -R $pkgs"
    echo
    paru -R $pkgs
fi
