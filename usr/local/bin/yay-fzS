#!/bin/bash
set -eu

fzf_args=(
  --ansi
  --multi
  --preview 'yay -Sii {1} | bat -p -f -l yaml'
  --preview-label=' alt-p: toggle description, alt-b/B: toggle PKGBUILD, page-up/down: scroll, tab: multi-select '
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'page-up:preview-up,page-down:preview-down'
  --bind 'alt-b:change-preview:yay -Gp {1} | tail -n +5 | bat -p -f -l bash'
  --bind 'alt-B:change-preview:yay -Sii {1} | bat -p -f -l yaml'
  --color 'pointer:green,marker:green'
)

yay_fifo="$(mktemp -u /tmp/yay-fzS-fifo-XXXXXXXXXXXX)"
mkfifo $yay_fifo
sed_fifo="$(mktemp -u /tmp/yay-fzS-fifo-XXXXXXXXXXXX)"
mkfifo $sed_fifo

yay -Sl --color=always >$yay_fifo &
yay_pid=$!

sed -E -e 's|^\x1B\[35m|\x1B[1;35m|g' -e 's|^\x1B\[1;35m([^ ]+) |\x1B[1;34m\1\x1B[0m/|g' -e 's|^\x1B\[1;34m(chaotic-)?aur|\x1B[1;36m\1aur|g' <$yay_fifo >$sed_fifo &
sed_pid=$!

pkgs=$(fzf "${fzf_args[@]}" <$sed_fifo | cut -d' ' -f1)

kill $sed_pid 2> /dev/null || true
kill $yay_pid 2> /dev/null || true
rm $sed_fifo
rm $yay_fifo

sys_pkgs=()
aur_pkgs=()
for pkg in $pkgs; do
    if [[ $pkg == aur/* ]]; then
        aur_pkgs+=($pkg)
    else
        sys_pkgs+=($pkg)
    fi
done

if [ -v sys_pkgs ]; then
    echo -e "\x1B[1;34m::\x1B[1;37m Running:\x1B[0m pkexec pacman -S ${sys_pkgs[@]}"
fi
if [ -v aur_pkgs ]; then
    echo -e "\x1B[1;34m::\x1B[1;37m Running:\x1B[0m yay -S ${aur_pkgs[@]}"
fi
echo
if [ -v sys_pkgs ]; then
    pkexec pacman -S ${sys_pkgs[@]}
fi
if [ -v aur_pkgs ]; then
    yay -S ${aur_pkgs[@]}
fi
